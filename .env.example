# ==========================================
# DATABASE CONNECTION (PostgreSQL & Prisma)
# ==========================================
# Standard PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public&sslmode=prefer
#
# Examples:
# - Local PostgreSQL: postgresql://postgres:postgres123@localhost:5432/galma_pharmacy?schema=public
# - Supabase (Pooler): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# - Neon: postgresql://[user]:[password]@[ep-host].neon.tech/[dbname]?sslmode=require
# - Railway / Render: postgresql://postgres:[password]@[host]:[port]/railway
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/galma_pharmacy?schema=public"

# Direct URL for migrations & schema push (Required when using connection pooling e.g. Supabase port 5432 direct, or Neon)
DIRECT_URL="postgresql://postgres:postgres123@localhost:5432/galma_pharmacy?schema=public"

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Secret key for JWT signing (Generate with: openssl rand -base64 32)
JWT_SECRET="galma-pharmacy-jwt-secret-key-2026-secure-token"
AUTH_SECRET="galma_pharmacy_secret_key_change_in_production_2026"

# Base application URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment mode (development | production)
NODE_ENV="development"

# ==========================================
# INITIAL ADMIN SEED CREDENTIALS
# ==========================================
ADMIN_EMAIL="admin@galmapharmacy.com"
ADMIN_PASSWORD="admin123456"
